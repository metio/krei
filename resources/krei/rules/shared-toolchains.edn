{:doc "The .breto.edn takes its versions from the registry groups; only the packages in :breto-pins may carry a version of their own."
 :when [:breto]
 :forbid {".breto.edn" ["\"([A-Za-z0-9._+-]+)@[0-9][^\"]*\""]}
 :allow :breto-pins}
