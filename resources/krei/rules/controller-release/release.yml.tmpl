# SPDX-FileCopyrightText: {{copyright}}
# SPDX-License-Identifier: {{license}}

name: Release
on:
{% if release.cron %}  schedule:
    - cron: {{release.cron}}
{% else %}  push:
    branches: [{{default-branch}}]
{% endif %}  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: {% verbatim %}${{ github.workflow }}{% endverbatim %}
  cancel-in-progress: false
jobs:
  prepare:
    name: Prepare Release
    runs-on: ubuntu-latest
    timeout-minutes: 15
    outputs:
      needed: {% verbatim %}${{ steps.gate.outputs.needed }}{% endverbatim %}
      version: {% verbatim %}${{ steps.version.outputs.version }}{% endverbatim %}
      previous: {% verbatim %}${{ steps.gate.outputs.last }}{% endverbatim %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - id: gate
        uses: metio/ci/needs-release@{{ci.ref}} # {{ci.version}}
        with:
          paths: {% if controller-release.paths %}{{controller-release.paths}}{% else %}go.mod main.go internal api config Dockerfile{% endif %}
      - id: version
        if: steps.gate.outputs.needed == 'true'
        uses: metio/ci/calver@{{ci.ref}} # {{ci.version}}
  build:
    name: Build {% verbatim %}${{ matrix.goos }}/${{ matrix.goarch }}{% endverbatim %}
    needs: prepare
    if: needs.prepare.outputs.needed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      matrix:
        # The linux architectures of gcr.io/distroless/static, plus the desktop platforms.
        include:
          - goos: linux
            goarch: amd64
          - goos: linux
            goarch: arm
            goarm: "7"
          - goos: linux
            goarch: arm64
          - goos: linux
            goarch: ppc64le
          - goos: linux
            goarch: riscv64
          - goos: linux
            goarch: s390x
          - goos: windows
            goarch: amd64
          - goos: windows
            goarch: arm64
          - goos: darwin
            goarch: amd64
          - goos: darwin
            goarch: arm64
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: metio/ci/breto@{{ci.ref}} # {{ci.version}}
        with:
          registries: github:metio/toolchains
      - name: Build and archive
        run: |
          set -euo pipefail
          ext=""
          [ "$GOOS" = windows ] && ext=".exe"
          ldflags="-s -w -X main.version=${VERSION} -X main.commit=${GITHUB_SHA}"
          pack() {
            name="$1"; pkg="$2"
            go build -o "${name}_v${VERSION}${ext}" -trimpath -ldflags="${ldflags}" "${pkg}"
            if [ "$GOOS" = windows ]; then
              zip "${name}_${VERSION}_${GOOS}_${GOARCH}.zip" "${name}_v${VERSION}${ext}" LICENSE README.md
            else
              tar --create --gzip --file "${name}_${VERSION}_${GOOS}_${GOARCH}.tar.gz" "${name}_v${VERSION}${ext}" LICENSE README.md
            fi
          }
{% for b in controller-release.binaries %}          pack {{b.name}} {{b.package}}
{% empty %}          pack {{name}} .
{% endfor %}        env:
          CGO_ENABLED: 0
          GOOS: {% verbatim %}${{ matrix.goos }}{% endverbatim %}
          GOARCH: {% verbatim %}${{ matrix.goarch }}{% endverbatim %}
          GOARM: {% verbatim %}${{ matrix.goarm }}{% endverbatim %}
          VERSION: {% verbatim %}${{ needs.prepare.outputs.version }}{% endverbatim %}
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist-{% verbatim %}${{ matrix.goos }}-${{ matrix.goarch }}{% endverbatim %}
          if-no-files-found: error
          path: |
            *.tar.gz
            *.zip
  container:
    name: Container Release
    needs: [prepare, build]
    if: needs.prepare.outputs.needed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      id-token: write # cosign keyless image signing
      contents: read
      packages: write # push to GHCR
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: metio/ci/container-release@{{ci.ref}} # {{ci.version}}
        with:
          image: ghcr.io/{% verbatim %}${{ github.repository }}{% endverbatim %}
          version: {% verbatim %}${{ needs.prepare.outputs.version }}{% endverbatim %}
  github:
    name: GitHub Release
    # The notes name the image tag, so a failed image build skips the release.
    needs: [prepare, build, container]
    if: needs.prepare.outputs.needed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      id-token: write # cosign keyless sign-blob
    env:
      VERSION: {% verbatim %}${{ needs.prepare.outputs.version }}{% endverbatim %}
      SUMS: {% verbatim %}${{ github.event.repository.name }}_${{ needs.prepare.outputs.version }}_SHA256SUMS{% endverbatim %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          path: dist
          pattern: dist-*
          merge-multiple: true
      - name: Calculate Checksums
        run: |
          cd dist
          shopt -s nullglob
          sha256sum ./*.tar.gz ./*.zip > "$SUMS"
      - uses: metio/ci/cosign-sign-blob@{{ci.ref}} # {{ci.version}}
        with:
          file: dist/{% verbatim %}${{ github.event.repository.name }}_${{ needs.prepare.outputs.version }}_SHA256SUMS{% endverbatim %}
      - id: notes
        uses: metio/ci/release-notes@{{ci.ref}} # {{ci.version}}
        with:
          version: {% verbatim %}${{ needs.prepare.outputs.version }}{% endverbatim %}
          previous: {% verbatim %}${{ needs.prepare.outputs.previous }}{% endverbatim %}
      - name: Append usage and verification footer
        env:
          NOTES: {% verbatim %}${{ steps.notes.outputs.file }}{% endverbatim %}
        run: |
          cat >> "$NOTES" <<EOF

          ## Usage

          Pull the container from \`ghcr.io/metio/{{name}}:${VERSION}\`.
          See **Upgrading** — {{controller-release.upgrading}} — for any required actions on your part.

          Prebuilt binaries are attached below{% if controller-release.binaries %} for{% for b in controller-release.binaries %}{% if forloop.last %} and{% elif not forloop.first %},{% endif %} \`{{b.name}}\`{% endfor %}{% endif %}:

          - \`linux\`: \`amd64\`, \`arm\` (v7), \`arm64\`, \`ppc64le\`, \`riscv64\`, \`s390x\`
          - \`windows\`: \`amd64\`, \`arm64\` (\`.zip\`)
          - \`darwin\` (macOS): \`amd64\`, \`arm64\`
{% if controller-release.usage %}
          {{controller-release.usage}}
{% endif %}
          ## Verify

          All release artifacts are signed with cosign keyless. See **Verifying releases** — {{controller-release.verifying}} — for the verification commands.
          EOF
      - name: Create Release
        run: gh release create "$VERSION" --target "$GITHUB_SHA" --title "$VERSION" --notes-file "$NOTES" dist/*.tar.gz dist/*.zip "dist/$SUMS" "dist/$SUMS.bundle"
        env:
          GH_TOKEN: {% verbatim %}${{ github.token }}{% endverbatim %}
          NOTES: {% verbatim %}${{ steps.notes.outputs.file }}{% endverbatim %}
