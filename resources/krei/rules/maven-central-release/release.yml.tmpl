# SPDX-FileCopyrightText: {{copyright}}
# SPDX-License-Identifier: {{license}}

name: Release
on:
{% if release.cron %}  schedule:
    - cron: {{release.cron}}
{% else %}  push:
    branches:
      - {{default-branch}}
{% endif %}  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: {% verbatim %}${{ github.workflow }}{% endverbatim %}
  cancel-in-progress: false

jobs:
  release:
    name: Release
    uses: metio/ci/.github/workflows/maven-central-release.yml@{{ci.ref}} # {{ci.version}}
    with:
      paths: {{maven-central.paths}}
{% if maven-central.deploy-args %}      deploy-args: {{maven-central.deploy-args}}
{% endif %}    secrets: inherit
