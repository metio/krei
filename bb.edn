{:paths ["src" "resources"]
 ;; babashka resolves git deps through tools.deps, which needs a JDK once per
 ;; sha; babashka carries babashka.fs and babashka.process itself.
 :deps {io.github.metio/briko {:git/sha "94bb776062a8fb35676600752b1d28d525dedc1c"}}
 :tasks
 {test {:doc "Runs all unit tests"
        :extra-paths ["test"]
        :requires ([krei.test-runner :as runner])
        :task (runner/run "test")}}}
