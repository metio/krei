name: Verify
on:
  pull_request:
    branches: [{{default-branch}}]

permissions:
  contents: read

jobs:
  maven:
    name: Maven
    uses: metio/ci/.github/workflows/maven.yml@{{ci.ref}} # {{ci.version}}
{% if any maven-verify.goals maven-verify.maven-args %}    with:
{% if maven-verify.goals %}      goals: {{maven-verify.goals}}
{% endif %}{% if maven-verify.maven-args %}      maven-args: {{maven-verify.maven-args}}
{% endif %}{% endif %}  github-actions:
    name: github-actions
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - uses: reviewdog/action-actionlint@48e36f54d8da326b83ab061aee2cc5e01b5ca46f # v1
        with:
          fail_on_error: true
          filter_mode: nofilter
  verify:
    name: Verify
    needs: [maven, github-actions]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Verify every job succeeded or skipped
        env:
          NEEDS: {% verbatim %}${{ toJSON(needs) }}{% endverbatim %}
        run: |
          bad=$(echo "$NEEDS" | jq -r 'to_entries[] | select(.value.result != "success" and .value.result != "skipped") | "\(.key)=\(.value.result)"')
          [ -z "$bad" ] || { echo "::error::$bad"; exit 1; }
