# SPDX-FileCopyrightText: {{copyright}}
# SPDX-License-Identifier: {{license}}

name: Release
on:
  schedule:
    - cron: {{release.cron}}
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: {% verbatim %}${{ github.workflow }}{% endverbatim %}
  cancel-in-progress: false
jobs:
  prepare:
    name: Prepare Release
    runs-on: ubuntu-latest
    timeout-minutes: 30
    outputs:
      commit_count: {% verbatim %}${{ steps.commits.outputs.count }}{% endverbatim %}
      release_version: {% verbatim %}${{ steps.release.outputs.version }}{% endverbatim %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - id: last_release
        name: Fetch Last Release
        run: echo "tag=$(gh release view --json tagName --jq '.tagName')" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: {% verbatim %}${{ github.token }}{% endverbatim %}
      - id: commits
        name: Count Commits
        run: echo "count=$(git rev-list --count "${LAST_RELEASE}..HEAD")" >> "$GITHUB_OUTPUT"
        env:
          LAST_RELEASE: {% verbatim %}${{ steps.last_release.outputs.tag }}{% endverbatim %}
      - id: release
        name: Create Release Version
        if: steps.commits.outputs.count > 0
        run: echo "version=$(date +'%Y.%-m.%-d')" >> "$GITHUB_OUTPUT"
  build:
    name: Build {% verbatim %}${{ matrix.goos }}/${{ matrix.goarch }}{% endverbatim %}
    needs: prepare
    if: needs.prepare.outputs.commit_count > 0
    runs-on: ubuntu-latest
    timeout-minutes: {% if terraform-provider-release.build-timeout-minutes %}{{terraform-provider-release.build-timeout-minutes}}{% else %}30{% endif %}
    strategy:
      matrix:
        include:
{% for p in terraform-provider-release.platforms %}          - goos: {{p.goos}}
            goarch: {{p.goarch}}
{% empty %}          - goos: freebsd
            goarch: amd64
          - goos: freebsd
            goarch: 386
          - goos: freebsd
            goarch: arm
          - goos: freebsd
            goarch: arm64
          - goos: windows
            goarch: amd64
          - goos: windows
            goarch: 386
          - goos: windows
            goarch: arm64
          - goos: linux
            goarch: amd64
          - goos: linux
            goarch: 386
          - goos: linux
            goarch: arm
          - goos: linux
            goarch: arm64
          - goos: darwin
            goarch: amd64
          - goos: darwin
            goarch: arm64
{% endfor %}    env:
      VERSION: {% verbatim %}${{ needs.prepare.outputs.release_version }}{% endverbatim %}
      GOOS: {% verbatim %}${{ matrix.goos }}{% endverbatim %}
      GOARCH: {% verbatim %}${{ matrix.goarch }}{% endverbatim %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: metio/ci/breto@{{ci.ref}} # {{ci.version}}
        with:
          registries: github:metio/toolchains
      - name: Build Provider
        run: |
          binary="{{name}}_v${VERSION}"
          if [ "$GOOS" = windows ]; then binary="$binary.exe"; fi
          go build -trimpath -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${GITHUB_SHA}" -o "$binary"
          zip --recurse-paths "{{name}}_${VERSION}_${GOOS}_${GOARCH}.zip" "$binary" LICENSE LICENSES README.md
        env:
          CGO_ENABLED: 0
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: {{name}}-{% verbatim %}${{ matrix.goos }}-${{ matrix.goarch }}{% endverbatim %}
          path: {{name}}_{% verbatim %}${{ needs.prepare.outputs.release_version }}_${{ matrix.goos }}_${{ matrix.goarch }}{% endverbatim %}.zip
  release:
    name: GitHub Release
    needs: [prepare, build]
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
    env:
      VERSION: {% verbatim %}${{ needs.prepare.outputs.release_version }}{% endverbatim %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          path: dist
          pattern: {{name}}-*
          merge-multiple: true
      - name: Calculate Checksums
        run: |
          cp terraform-registry-manifest.json "dist/{{name}}_${VERSION}_manifest.json"
          cd dist
          sha256sum -- *.zip "{{name}}_${VERSION}_manifest.json" > "{{name}}_${VERSION}_SHA256SUMS"
      # The Terraform Registry only accepts a GPG signature of the checksums.
      - name: Sign Checksums
        run: |
          export GNUPGHOME="$RUNNER_TEMP/gnupg"
          mkdir --mode=700 "$GNUPGHOME"
          printf '%s' "$GPG_SECRET_KEY_BASE64" | base64 --decode | gpg --batch --import
          printf '%s' "$GPG_SECRET_KEY_PASSWORD" | gpg --batch --pinentry-mode loopback --passphrase-fd 0 \
            --output "dist/{{name}}_${VERSION}_SHA256SUMS.sig" --detach-sign "dist/{{name}}_${VERSION}_SHA256SUMS"
        env:
          GPG_SECRET_KEY_BASE64: {% verbatim %}${{ secrets.GPG_SECRET_KEY_BASE64 }}{% endverbatim %}
          GPG_SECRET_KEY_PASSWORD: {% verbatim %}${{ secrets.GPG_SECRET_KEY_PASSWORD }}{% endverbatim %}
      - name: Create Release
        run: gh release create "$VERSION" --target "$GITHUB_SHA" --title "$VERSION" --generate-notes dist/*
        env:
          GH_TOKEN: {% verbatim %}${{ github.token }}{% endverbatim %}{% if terraform-provider-release.notify %}
      - name: Send Mail
        uses: dawidd6/action-send-mail@47af4a10b540781705f283a2cf1a9650713ac795 # v23
        with:
          server_address: {% verbatim %}${{ secrets.MAIL_SERVER }}{% endverbatim %}
          server_port: {% verbatim %}${{ secrets.MAIL_PORT }}{% endverbatim %}
          username: {% verbatim %}${{ secrets.MAIL_USERNAME }}{% endverbatim %}
          password: {% verbatim %}${{ secrets.MAIL_PASSWORD }}{% endverbatim %}
          subject: {% verbatim %}${{ github.event.repository.name }} version ${{ needs.prepare.outputs.release_version }}{% endverbatim %} published
          body: See {% verbatim %}${{ github.server_url }}/${{ github.repository }}/releases/tag/${{ needs.prepare.outputs.release_version }}{% endverbatim %} for details.
          to: {% verbatim %}${{ secrets.MAIL_RECIPIENT }}{% endverbatim %}
          from: {% verbatim %}${{ secrets.MAIL_SENDER }}{% endverbatim %}
      - name: Send Matrix Message
        uses: s3krit/matrix-message-action@70ad3fb812ee0e45ff8999d6af11cafad11a6ecf # v0.0.3
        with:
          room_id: {% verbatim %}${{ secrets.MATRIX_ROOM_ID }}{% endverbatim %}
          access_token: {% verbatim %}${{ secrets.MATRIX_ACCESS_TOKEN }}{% endverbatim %}
          message: {% verbatim %}${{ github.event.repository.name }} version [${{ needs.prepare.outputs.release_version }}](${{ github.server_url }}/${{ github.repository }}/releases/tag/${{ needs.prepare.outputs.release_version }}{% endverbatim %}) published
          server: {% verbatim %}${{ secrets.MATRIX_SERVER }}{% endverbatim %}{% endif %}
